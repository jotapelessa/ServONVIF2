<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E293B" android:endColor="#0F172A" android:angle="270" />
            <stroke android:width="2dp" android:color="#38BDF8" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0B0F19" />
            <stroke android:width="1.5dp" android:color="#60A5FA" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E293B" android:endColor="#111827" android:angle="270" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
