<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focado (D-Pad Focus com Borda Ciano Neon) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2638" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#00D2FF" />
        </shape>
    </item>
    <!-- Selecionado / Pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2563EB" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#60A5FA" />
        </shape>
    </item>
    <!-- Estado Padrão -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101826" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1E293B" />
        </shape>
    </item>
</selector>
