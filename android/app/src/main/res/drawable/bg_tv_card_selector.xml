<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: High-contrast Cyan border with slight elevation -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#162035" />
            <stroke android:width="3dp" android:color="#38BDF8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Selected / Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E2E4E" />
            <stroke android:width="3dp" android:color="#0EA5E9" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Default Unfocused State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1424" />
            <stroke android:width="1.2dp" android:color="#1B2844" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
