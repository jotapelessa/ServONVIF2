<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="36dp"
    android:background="#0B0F19">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚙️ Configurações do ServONVIF TV"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP do Servidor / Computador"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTvServerIp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E293B"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:focusable="true"
                android:hint="ex: 192.168.1.96"
                android:textColorHint="#64748B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Porta da API"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTvServerPort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E293B"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:focusable="true"
                android:text="8080" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swTvSoundAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emitir aviso sonoro (chime) ao detectar movimento"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:focusable="true"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/swTvAutoStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar monitoramento automaticamente ao ligar a TV"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:focusable="true"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnTvTestConnection"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Testar Conexão"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:focusable="true"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnTvSaveSettings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Salvar e Voltar"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTvStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#38BDF8"
        android:textSize="14sp" />
</LinearLayout>
