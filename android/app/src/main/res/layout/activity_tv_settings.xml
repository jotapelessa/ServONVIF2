<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Configurações &amp; Personalização do ServONVIF"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Network Config Group -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP do Servidor Mac / PC"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTvServerIp"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1E293B"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:focusable="true"
                    android:hint="ex: 192.168.1.96"
                    android:textColorHint="#64748B" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Porta da API"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTvServerPort"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="#1E293B"
                    android:textColor="#FFFFFF"
                    android:padding="12dp"
                    android:focusable="true"
                    android:text="8080" />
            </LinearLayout>
        </LinearLayout>

        <!-- Position Selector Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Posição da Janela Flutuante de Alerta na Tela:"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnPosTopRight"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="↗️ Superior Direito"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPosTopLeft"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="↖️ Superior Esquerdo"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPosBottomRight"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="↘️ Inferior Direito"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPosBottomLeft"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="↙️ Inferior Esquerdo"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPosCenter"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="🔲 Centro"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Size Selector Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📐 Tamanho Pré-Configurado da Janela Flutuante:"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnSizeSmall"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📱 Pequeno (Compacto)"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSizeMedium"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="📺 Médio (Padrão 16:9)"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSizeLarge"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="🖥️ Grande (Destaque)"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Duration Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Duração de Exibição do Alerta na Tela:"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnDur5s"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="5 Segundos"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDur10s"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="10 Segundos"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDur15s"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="15 Segundos"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnDur30s"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="30 Segundos"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Switches -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swTvSoundAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emitir aviso sonoro (chime) no alarme"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:focusable="true"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swTvAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar monitoramento automaticamente ao ligar o aparelho"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:focusable="true"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="20dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTvTestConnection"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📡 Testar Conexão"
                android:backgroundTint="#334155"
                android:textColor="#FFFFFF"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnTvSaveSettings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="💾 Salvar Configurações"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
