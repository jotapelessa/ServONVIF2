<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardCameraRoot"
    android:layout_width="280dp"
    android:layout_height="158dp"
    android:layout_marginEnd="18dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_tv_card_selector"
    android:padding="3dp">

    <!-- Inner Card Container with Rounded Corners & Background -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#090E18">

        <!-- Camera Thumbnail / Snapshot -->
        <ImageView
            android:id="@+id/imgCameraThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Camera Preview" />

        <!-- Cinematic Gradient Overlay for Maximum Text Contrast -->
        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_tv_hero_gradient" />

        <!-- Top Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardLiveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_live_badge"
                android:text="● AO VIVO"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCardMotionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_motion_alert_badge"
                android:text="MOVIMENTO"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bottom Metadata Container (Progressive Reveal on Focus) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvCardCameraName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Câmera 5MP Entrada"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/layoutCardExtraMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvCardCameraRes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5MP • 2880x1620"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCardCameraFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 FPS"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
