<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#070B14"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Left Navigation Rail / Sidebar (TV Ergonomic & High Contrast) -->
    <LinearLayout
        android:id="@+id/sidebarLayout"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0D131F"
        android:padding="18dp"
        android:layout_marginEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ServONVIF"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAMING CENTER"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="28dp" />

        <!-- Nav Items -->
        <Button
            android:id="@+id/btnNavHome"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🏠  Início"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:background="@drawable/bg_tv_hero_btn_selector"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="10dp"
            android:nextFocusDown="@+id/btnNavMosaic"
            android:nextFocusRight="@+id/btnHeroFullscreen" />

        <Button
            android:id="@+id/btnNavMosaic"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🪟  Mosaico"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:background="@drawable/bg_tv_hero_btn_secondary_selector"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="10dp"
            android:nextFocusUp="@+id/btnNavHome"
            android:nextFocusDown="@+id/btnNavEvents"
            android:nextFocusRight="@+id/btnHeroFullscreen" />

        <Button
            android:id="@+id/btnNavEvents"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔔  Alertas &amp; LPR"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:background="@drawable/bg_tv_hero_btn_secondary_selector"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="10dp"
            android:nextFocusUp="@+id/btnNavMosaic"
            android:nextFocusDown="@+id/btnNavTests"
            android:nextFocusRight="@+id/btnHeroFullscreen" />

        <Button
            android:id="@+id/btnNavTests"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🧪  Diagnóstico"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:background="@drawable/bg_tv_hero_btn_secondary_selector"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginBottom="10dp"
            android:nextFocusUp="@+id/btnNavEvents"
            android:nextFocusDown="@+id/btnNavSettings"
            android:nextFocusRight="@+id/btnHeroFullscreen" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⚙️  Ajustes"
            android:gravity="start|center_vertical"
            android:paddingStart="14dp"
            android:background="@drawable/bg_tv_hero_btn_secondary_selector"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/btnNavTests"
            android:nextFocusRight="@+id/btnHeroFullscreen" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- System Clock & Server Status Pill -->
        <TextView
            android:id="@+id/tvTvClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#F8FAFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTvServerStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Conectando..."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- 2. Main Content Area with Smooth Vertical Scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Cinematic Hero Section (Spotlight Active Camera) -->
            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="#0A101D"
                android:layout_marginBottom="24dp">

                <!-- Live Hero Player / Snapshot Stream -->
                <WebView
                    android:id="@+id/webHeroStream"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Cinematic Dark Gradient Overlays -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_tv_hero_gradient" />

                <!-- Hero Content Overlay (Text & Primary Quick Actions) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:id="@+id/tvHeroLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_live_badge"
                            android:text="● AO VIVO NO SPOTLIGHT"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvHeroMeta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sensor 5MP • 2880x1620 • 25 FPS • ONVIF RTSP"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carregando Câmera..."
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Monitoramento contínuo com inteligência artificial e detecção ativa de movimento."
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:layout_marginBottom="16dp" />

                    <!-- Hero Quick Action Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnHeroFullscreen"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="▶ Assistir em Tela Cheia"
                            android:background="@drawable/bg_tv_hero_btn_selector"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:focusable="true"
                            android:clickable="true"
                            android:paddingHorizontal="20dp"
                            android:layout_marginEnd="12dp"
                            android:nextFocusLeft="@+id/btnNavHome"
                            android:nextFocusRight="@+id/btnHeroPip"
                            android:nextFocusDown="@+id/recyclerCamerasRow" />

                        <Button
                            android:id="@+id/btnHeroPip"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="🗔 Modo PiP"
                            android:background="@drawable/bg_tv_hero_btn_secondary_selector"
                            android:textColor="#E2E8F0"
                            android:textSize="14sp"
                            android:focusable="true"
                            android:clickable="true"
                            android:paddingHorizontal="18dp"
                            android:layout_marginEnd="12dp"
                            android:nextFocusLeft="@+id/btnHeroFullscreen"
                            android:nextFocusRight="@+id/btnHeroPatrol"
                            android:nextFocusDown="@+id/recyclerCamerasRow" />

                        <Button
                            android:id="@+id/btnHeroPatrol"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="🔄 Patrulha Auto"
                            android:background="@drawable/bg_tv_hero_btn_secondary_selector"
                            android:textColor="#E2E8F0"
                            android:textSize="14sp"
                            android:focusable="true"
                            android:clickable="true"
                            android:paddingHorizontal="18dp"
                            android:nextFocusLeft="@+id/btnHeroPip"
                            android:nextFocusDown="@+id/recyclerCamerasRow" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Loading & Empty State Views -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"
                android:background="#0D1424">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nenhuma Câmera Conectada"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verifique se o ServONVIF Server está online na rede local ou Tailscale."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnEmptyRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="🔄 Tentar Novamente"
                    android:background="@drawable/bg_tv_hero_btn_selector"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- Horizontal Row: Câmeras ao Vivo (5MP Ultra-HD) -->
            <LinearLayout
                android:id="@+id/layoutCamerasRowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câmeras em Tempo Real (5MP Ultra-HD)"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCamerasRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@+id/btnHeroFullscreen"
                    android:nextFocusDown="@+id/recyclerEventsRow" />
            </LinearLayout>

            <!-- Horizontal Row: Detecções & Eventos Recentes (LPR / Movimento) -->
            <LinearLayout
                android:id="@+id/layoutEventsRowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detecções &amp; Eventos Recentes (LPR / Veículos)"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEventsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@+id/recyclerCamerasRow" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
