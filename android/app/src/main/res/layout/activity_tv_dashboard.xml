<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F19"
    android:padding="20dp">

    <!-- Header & Navigation Bar (D-Pad & Touch Enabled with Glowing Focus Rings) -->
    <LinearLayout
        android:id="@+id/navBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ ServONVIF Central"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNavCameras"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="📺 Mosaico de Câmeras"
                    android:background="@drawable/btn_tv_action_blue_selector"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="10dp"
                    android:nextFocusRight="@+id/btnNavStatus"
                    android:nextFocusDown="@+id/sectionContainer" />

                <Button
                    android:id="@+id/btnNavStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="📊 Status &amp; Diagnóstico"
                    android:background="@drawable/btn_tv_action_dark_selector"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="10dp"
                    android:nextFocusLeft="@+id/btnNavCameras"
                    android:nextFocusRight="@+id/btnNavTests"
                    android:nextFocusDown="@+id/sectionContainer" />

                <Button
                    android:id="@+id/btnNavTests"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="🧪 Central de Testes"
                    android:background="@drawable/btn_tv_action_dark_selector"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="10dp"
                    android:nextFocusLeft="@+id/btnNavStatus"
                    android:nextFocusRight="@+id/btnNavSettings"
                    android:nextFocusDown="@+id/sectionContainer" />

                <Button
                    android:id="@+id/btnNavSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="⚙️ Configurações"
                    android:background="@drawable/btn_tv_action_dark_selector"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/btnNavTests"
                    android:nextFocusDown="@+id/sectionContainer" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Dynamic Content Container -->
    <FrameLayout
        android:id="@+id/sectionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SECTION 1: Cameras Live Dashboard -->
        <LinearLayout
            android:id="@+id/sectionCameras"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <WebView
                android:id="@+id/tvMainWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:focusable="true"
                android:nextFocusUp="@+id/btnNavCameras" />
        </LinearLayout>

        <!-- SECTION 2: Real-time System Status & Live Event Feed -->
        <ScrollView
            android:id="@+id/sectionStatus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visão Geral do Monitoramento em Tempo Real"
                    android:textColor="#E2E8F0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Grid of Status Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Server Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="16dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖥️ Servidor Mac / PC"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCardServerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 Online"
                            android:textColor="#22C55E"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvCardServerIp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="192.168.1.96:8080"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- WebSocket Sentinel Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="16dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📡 Sentinela em 2º Plano"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCardWsStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 Conectado"
                            android:textColor="#38BDF8"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvCardEventCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pronto para disparar PiP"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Active Cameras Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 Câmeras Conectadas"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCardCameraCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- Câmeras"
                            android:textColor="#F59E0B"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvCardCameraNames"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sincronizando com o servidor..."
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Last Detected Event Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E293B"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔔 Último Alerta de Movimento Recebido"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCardLastEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aguardando detecção de movimento do servidor..."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- SECTION 3: Test & Diagnostic Laboratory -->
        <ScrollView
            android:id="@+id/sectionTests"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪 Central de Testes, Auto-Descoberta e Simulação"
                    android:textColor="#E2E8F0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Navegue com as setas do controle remoto e pressione OK para executar os testes:"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Row 1: Real Action Simulation & Auto Discovery -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnTestSimulateMotion"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🎯 Simular Movimento Real (End-to-End)"
                        android:background="@drawable/btn_tv_action_green_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_marginEnd="10dp"
                        android:nextFocusUp="@+id/btnNavTests"
                        android:nextFocusRight="@+id/btnTestAutoDiscoverServer"
                        android:nextFocusDown="@+id/btnTestPiPAlert" />

                    <Button
                        android:id="@+id/btnTestAutoDiscoverServer"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🔍 Auto-Detectar Servidor Mac"
                        android:background="@drawable/btn_tv_action_blue_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusUp="@+id/btnNavTests"
                        android:nextFocusLeft="@+id/btnTestSimulateMotion"
                        android:nextFocusDown="@+id/btnTestServerPing" />
                </LinearLayout>

                <!-- Row 2: PiP, Audio & Network Tests -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnTestPiPAlert"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🪟 Testar Janela PiP (10s)"
                        android:background="@drawable/btn_tv_action_blue_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_marginEnd="10dp"
                        android:nextFocusUp="@+id/btnTestSimulateMotion"
                        android:nextFocusRight="@+id/btnTestSoundChime"
                        android:nextFocusDown="@+id/btnTestSyncCameras" />

                    <Button
                        android:id="@+id/btnTestSoundChime"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🔔 Testar Som Chime"
                        android:background="@drawable/btn_tv_action_dark_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_marginEnd="10dp"
                        android:nextFocusUp="@+id/btnTestSimulateMotion"
                        android:nextFocusLeft="@+id/btnTestPiPAlert"
                        android:nextFocusRight="@+id/btnTestServerPing"
                        android:nextFocusDown="@+id/btnTestHeadsUpNotification" />

                    <Button
                        android:id="@+id/btnTestServerPing"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="📡 Testar Ping Servidor"
                        android:background="@drawable/btn_tv_action_dark_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusUp="@+id/btnTestAutoDiscoverServer"
                        android:nextFocusLeft="@+id/btnTestSoundChime"
                        android:nextFocusDown="@+id/btnTestOverlayPermission" />
                </LinearLayout>

                <!-- Row 3: Sync, HeadsUp & Overlays -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <Button
                        android:id="@+id/btnTestSyncCameras"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🔄 Sincronizar Câmeras"
                        android:background="@drawable/btn_tv_action_dark_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_marginEnd="10dp"
                        android:nextFocusUp="@+id/btnTestPiPAlert"
                        android:nextFocusRight="@+id/btnTestHeadsUpNotification"
                        android:nextFocusDown="@+id/btnClearConsole" />

                    <Button
                        android:id="@+id/btnTestHeadsUpNotification"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🚨 Testar Notificação"
                        android:background="@drawable/btn_tv_action_red_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_marginEnd="10dp"
                        android:nextFocusUp="@+id/btnTestSoundChime"
                        android:nextFocusLeft="@+id/btnTestSyncCameras"
                        android:nextFocusRight="@+id/btnTestOverlayPermission"
                        android:nextFocusDown="@+id/btnClearConsole" />

                    <Button
                        android:id="@+id/btnTestOverlayPermission"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="🔑 Permissão Sobrepor"
                        android:background="@drawable/btn_tv_action_purple_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusUp="@+id/btnTestServerPing"
                        android:nextFocusLeft="@+id/btnTestHeadsUpNotification"
                        android:nextFocusDown="@+id/btnClearConsole" />
                </LinearLayout>

                <!-- Console Output Log Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Console de Diagnóstico em Tempo Real:"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnClearConsole"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Limpar Logs"
                        android:background="@drawable/btn_tv_action_dark_selector"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusUp="@+id/btnTestSyncCameras" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTestConsoleOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:background="#020617"
                    android:padding="16dp"
                    android:text="Aguardando execução de testes..."
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
