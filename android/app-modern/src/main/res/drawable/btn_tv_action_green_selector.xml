<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#10B981" android:endColor="#047857" android:angle="270" />
            <stroke android:width="2.5dp" android:color="#6EE7B7" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#065F46" android:endColor="#022C22" android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#059669" android:endColor="#047857" android:angle="270" />
            <stroke android:width="1dp" android:color="#10B981" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
