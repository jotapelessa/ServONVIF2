<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#8B5CF6" android:endColor="#6D28D9" android:angle="270" />
            <stroke android:width="2.5dp" android:color="#C4B5FD" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#5B21B6" android:endColor="#2E1065" android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#7C3AED" android:endColor="#6D28D9" android:angle="270" />
            <stroke android:width="1dp" android:color="#8B5CF6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
