<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#3B82F6" android:endColor="#1D4ED8" android:angle="270" />
            <stroke android:width="2.5dp" android:color="#60A5FA" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#1E40AF" android:endColor="#172554" android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#2563EB" android:endColor="#1D4ED8" android:angle="270" />
            <stroke android:width="1dp" android:color="#3B82F6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

