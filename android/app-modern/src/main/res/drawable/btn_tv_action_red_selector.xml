<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#EF4444" android:endColor="#B91C1C" android:angle="270" />
            <stroke android:width="2.5dp" android:color="#FCA5A5" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#991B1B" android:endColor="#450A0A" android:angle="270" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#DC2626" android:endColor="#B91C1C" android:angle="270" />
            <stroke android:width="1dp" android:color="#EF4444" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
