<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cellRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/selector_camera_cell"
    android:focusable="true"
    android:clickable="true"
    android:padding="2dp">

    <!-- Live Stream Video Player -->
    <WebView
        android:id="@+id/cellWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:focusable="false"
        android:clickable="false" />

    <!-- Offline / Placeholder Overlay -->
    <LinearLayout
        android:id="@+id/cellOfflineOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/card_bg"
        android:visibility="gone"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOfflineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Câmera Desconectada"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvOfflineSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tentando reconectar..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Top OSD Bar (Camera Name & Live Badge) -->
    <LinearLayout
        android:id="@+id/layoutTopOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:padding="8dp">

        <!-- Camera Name Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_osd_pill"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <View
                android:id="@+id/dotLive"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_live_badge"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvCellName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Câmera 1"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Camera Model / Quality Badge -->
        <TextView
            android:id="@+id/tvCellInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5MP • ONVIF"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:background="@drawable/bg_osd_pill"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Center Motion Alert Banner (Animated On Motion) -->
    <LinearLayout
        android:id="@+id/layoutCellMotionBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_motion_alert_badge"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMotionBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOVIMENTO DETECTADO"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom OSD Bar (Clock & Fullscreen Hint) -->
    <LinearLayout
        android:id="@+id/layoutBottomOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvCellClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_osd_pill"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCellHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[OK] Tela Cheia"
            android:textColor="@color/blue_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_osd_pill"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>
</FrameLayout>
