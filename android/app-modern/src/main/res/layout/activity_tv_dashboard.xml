<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B14">

    <!-- High-Performance Hardware Accelerated Webview for Google AI Studio Netflix UI -->
    <WebView
        android:id="@+id/tvMainWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="visible" />

    <!-- Loading Splash Spinner -->
    <ProgressBar
        android:id="@+id/tvLoadingProgress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#00D2FF"
        android:visibility="gone" />

</FrameLayout>
