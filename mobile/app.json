{
  "expo": {
    "name": "ServONVIF Mobile",
    "slug": "servonvif-mobile",
    "version": "002.002.182",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servonvif.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Permita o acesso à câmera para ler o QR Code de emparelhamento do ServONVIF."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B14"
      },
      "package": "com.servonvif.mobile",
      "versionCode": 2002182,
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para ler o QR Code de emparelhamento do ServONVIF."
        }
      ]
    ]
  }
}
