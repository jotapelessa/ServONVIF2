# ==============================================================================
# ServONVIF - Arquivo de Configuração de Ambiente (.env)
# ==============================================================================

# Configurações do Servidor
APP_NAME="ServONVIF Core Engine"
DEBUG=false
PORT=8080
HOST=0.0.0.0

# Armazenamento e Retenção
RETENTION_DAYS=7
DEFAULT_BUFFER_SECONDS=10
PRE_EVENT_SECONDS=3
POST_EVENT_SECONDS=5

# Resolução de Processamento da Detecção (Baixo uso de CPU/GPU)
SMALL_FRAME_WIDTH=640
SMALL_FRAME_HEIGHT=360

# Notificações via Bot do Telegram (BotFather)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_COOLDOWN_SECONDS=10

# Segurança e JWT
JWT_SECRET=super_secret_production_key_change_me
